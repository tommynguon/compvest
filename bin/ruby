#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$project_dir/.tools/bin:$PATH"
export MISE_DATA_DIR="$project_dir/.tools/data"
export MISE_CACHE_DIR="$project_dir/.tools/cache"
export MISE_CONFIG_DIR="$project_dir/.tools/config"
export MISE_STATE_DIR="$project_dir/.tools/state"
export GEM_SPEC_CACHE="$project_dir/.tools/gem-cache"

exec mise exec ruby@3.3.6 -- "$@"
